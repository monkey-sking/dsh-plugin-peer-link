{
  "name": "dsh-plugin-peer-link",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "Cross-host Peer-to-Peer AI collaboration and real-time trace ledger for DSH",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "peer-link",
    "p2p",
    "collaboration"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  }
}
